# Copy this file to .env and fill it in. .env is never committed.

# The pipeline page's address (no trailing slash), e.g.
#   https://clarity-creator-pipeline.<your-subdomain>.workers.dev
# For local testing against `npm run app:dev`: http://localhost:8787
APP_URL=

# Must be exactly the same value as the Worker secret ADMIN_TOKEN.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Optional. Path to Chrome if it is not in the usual place.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional. Keep a persistent Chrome profile (and log in to TikTok once with
# `npm run tiktok-login`). Leave unset for a fresh anonymous profile per run.
# TIKTOK_PROFILE_DIR=.chrome-profile

# Optional. HEADLESS=0 shows the Chrome window while scraping (useful to see
# what TikTok is showing when a run finds nothing).
# HEADLESS=0
